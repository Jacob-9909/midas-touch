# midas-touch 환경변수 예시 — 실제 값은 .env에 채우세요(.env는 git 제외).

# 주의: 값 뒤에 인라인 주석(# ...)을 붙이지 말 것 — dotenv가 주석을 값으로 읽음.
# ── API Keys ────────────────────────────────────────────────
# NVIDIA NIM (에이전트/리포트 생성 LLM)
NVIDIA_API_KEY=
# HuggingFace (임베딩 모델/파인튜닝)
HF_TOKEN=
# FRED 거시지표
FRED_API_KEY=
# 한국은행 ECOS
BOK_API_KEY=

# ── Live Research / 주식·청약 (wealth_advisor 통합) ──────────────
# 키 비우면 해당 기능 호출 시 명확한 "미설정" 안내가 반환됨(앱은 죽지 않음).
# 네이버 검색 API (금융상품 금리 리서치) https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Tavily 검색 (미·일·한 금리 동향) https://tavily.com
TAVILY_API_KEY=
# 국가법령정보 OC (국세청 법령해석) https://open.law.go.kr
LAW_GO_KR_OC=
# 공공데이터포털 청약홈 API https://www.data.go.kr
CHEONGYAK_API_KEY=
# (선택) 주식 기업 프로필 https://financialmodelingprep.com
FMP_API_KEY=

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# ── Models ───────────────────────────────────────────────────
AGENT_LLM_MODEL=meta/llama-3.3-70b-instruct
AGENT_EMBEDDING_MODEL=nlpai-lab/KURE-v1
NIM_GENERATION_MODEL=meta/llama-3.1-70b-instruct
PERSONA_GENERATION_MODEL=deepseek-ai/deepseek-v4-flash
TEACHER_EMBEDDING_MODEL=nlpai-lab/KURE-v1
STUDENT_EMBEDDING_MODEL=nlpai-lab/KURE-v1

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000
