# midas-touch 환경변수 예시 — 실제 값은 .env에 채우세요(.env는 git 제외).

# 주의: 값 뒤에 인라인 주석(# ...)을 붙이지 말 것 — dotenv가 주석을 값으로 읽음.
# ── API Keys ────────────────────────────────────────────────
# NVIDIA NIM (에이전트/리포트 생성 LLM). _2는 레이트리밋 우회용 보조 키(선택).
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
# HuggingFace (임베딩 모델/파인튜닝)
HF_TOKEN=
# FRED 거시지표
FRED_API_KEY=
# 한국은행 ECOS
BOK_API_KEY=

# ── Live Research / 주식·청약 (wealth_advisor 통합) ──────────────
# 키 비우면 해당 기능 호출 시 명확한 "미설정" 안내가 반환됨(앱은 죽지 않음).
# 네이버 검색 API (금융상품 금리 리서치) https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Tavily 검색 (미·일·한 금리 동향) https://tavily.com
TAVILY_API_KEY=
# 국가법령정보 OC (국세청 법령해석) https://open.law.go.kr
LAW_GO_KR_OC=
# 공공데이터포털 청약홈 API https://www.data.go.kr
CHEONGYAK_API_KEY=
# (선택) 주식 기업 프로필 https://financialmodelingprep.com
FMP_API_KEY=

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# ── Neo4j (지식 그래프) ──────────────────────────────────────
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
# NVIDIA NIM 키 1개당 분당 허용 호출 수(무료 티어 40). 지식그래프 빌더·엔티티 정제·
# 쿼리 합성·페르소나 생성이 별도 프로세스로 떠도 이 창을 파일 락으로 공유한다.
NIM_RPM=40
# 위 RPM 한도에 더해 호출 간 최소 간격을 강제하고 싶을 때만 사용(초). 0이면 미사용.
NIM_GRAPH_DELAY=0

# ── Models ───────────────────────────────────────────────────
# 에이전트 보고서 생성용 LLM
AGENT_LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
# 에이전트 쿼리 임베딩 모델 (persona_embeddings 적재 모델과 동일해야 함; 파인튜닝 후 산출물 경로로 교체)
AGENT_EMBEDDING_MODEL=nlpai-lab/KURE-v1
# 임베딩 파이프라인 쿼리 합성용 LLM
NIM_GENERATION_MODEL=qwen/qwen3-next-80b-a3b-instruct
# 합성 투자자 페르소나 생성용 LLM (NVIDIA NIM)
PERSONA_GENERATION_MODEL=qwen/qwen3-next-80b-a3b-instruct
# 하드 네거티브 마이닝 교사 임베딩 모델
TEACHER_EMBEDDING_MODEL=nlpai-lab/KURE-v1
# 파인튜닝 대상 학생 임베딩 모델
STUDENT_EMBEDDING_MODEL=nlpai-lab/KURE-v1

# ── Training (임베딩 파인튜닝: pipelines/embedding/train.py) ──────
# 손실 함수 — margin_mse: 교사 Margin 점수 지식 증류 / mnrl: 배치 내 대조 학습
TRAIN_LOSS_TYPE=margin_mse
# LoRA 학습률. 풀 파인튜닝 대비 높게 설정 가능 (~1e-4까지)
TRAIN_LEARNING_RATE=2e-5
# 학습 에폭 수. 데이터 적으면 5~10도 무방
TRAIN_NUM_EPOCHS=3
# 학습 배치 크기. GPU 메모리 부족 시 16으로 낮출 것
TRAIN_BATCH_SIZE=32
# 평가 배치 크기. 학습 배치의 2배 권장
TRAIN_EVAL_BATCH_SIZE=64
# 전체 스텝 중 lr warmup 비율 (0.06~0.1 권장)
TRAIN_WARMUP_RATIO=0.1
# MNRL loss 온도 파라미터. 클수록 hard negative 강조
TRAIN_MNRL_SCALE=20.0
# 몇 스텝마다 평가할지. 데이터 적으면 50~100
TRAIN_EVAL_STEPS=200
# 몇 스텝마다 체크포인트 저장할지
TRAIN_SAVE_STEPS=500
# FP16 혼합 정밀도. RTX 계열 GPU 사용 시 true
TRAIN_FP16=false
# BF16 혼합 정밀도. A100/H100 사용 시 true (fp16과 택1)
TRAIN_BF16=true
# 체크포인트 및 최종 모델 저장 경로
TRAINING_OUTPUT_DIR=./output/kure-finance-v1

# ── LoRA (train.py adapter 설정) ─────────────────────────────
# adapter 행렬 rank. 클수록 표현력↑ 파라미터↑ (범위: 8~64)
LORA_R=16
# scaling 계수 (실질 scale = alpha/r). 보통 r*2 권장
LORA_ALPHA=32
# adapter dropout. 데이터 적을수록 높게 (0.05~0.2)
LORA_DROPOUT=0.1
# LoRA 적용 레이어. key,dense 추가 시 성능↑ 메모리↑
LORA_TARGET_MODULES=query,value
# true: adapter를 base에 흡수 후 저장 / false: 분리 저장
LORA_MERGE_ON_SAVE=true

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── 분석 메모리 자동 검증 (학습 루프) ────────────────────────
# 분석시점 +N영업일 종가로 과거 예측을 채점해 신뢰도 캘리브레이션·유사 적중 가산점을 살린다.
ANALYSIS_VALIDATION_ENABLED=true
ANALYSIS_VALIDATION_INTERVAL_HOURS=12
ANALYSIS_VALIDATION_START_DELAY_SECONDS=60
